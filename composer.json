{
  "name": "zeimoto/image",
  "description": "Responsive image rendering with art direction and crop helpers.",
  "type": "kirby-plugin",
  "license": "MIT",
  "keywords": [
    "kirby",
    "kirby5",
    "zeimoto",
    "image"
  ],
  "authors": [
    {
      "name": "zeimoto"
    }
  ],
  "require": {
    "php": "^8.5",
    "getkirby/cms": "^5.6.1",
    "getkirby/composer-installer": "^1.2.1"
  },
  "extra": {
    "installer-name": "zeimoto-image"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  }
}
